OKTA_ORG_URL=https://org.okta.com
OKTA_CLIENT_ID=api_services_app
OKTA_KEY_ID=your_public_key_kid
OKTA_PRIVATE_KEY_FILE=secrets/okta-key.pem
OKTA_INITIAL_LOOKBACK=24h
COLLECTOR_ORG=your-org
COLLECTOR_SERVER=okta
COLLECTOR_STATE_DIR=state/okta
COLLECTOR_HTTP_ADDR=127.0.0.1:4196
COLLECTOR_OUTPUT=stdout
KAFKA_BROKERS=<kafka-host>:9094
KAFKA_TOPIC=okta
