GWS_CREDENTIALS_FILE=secrets/google-sa.json
GWS_ADMIN_SUBJECT=reports@yourdomain
GWS_INITIAL_LOOKBACK=24h
COLLECTOR_ORG=your-org
COLLECTOR_SERVER=google-workspace
COLLECTOR_STATE_DIR=state/gws
COLLECTOR_HTTP_ADDR=127.0.0.1:4195
COLLECTOR_OUTPUT=kafka
KAFKA_BROKERS=<kafka-host>:9094
KAFKA_TOPIC=google_workspace
